---
layout: layouts/base.njk
---
{% set all = collections.artikkelit %}
<div class="front">
  <div class="front__main">
    {% if all.length %}
      {% set item = all[0] %}{% set cardClass = "card--lead" %}{% set showExcerpt = false %}
      {% include "partials/card.njk" %}
    {% else %}
      <div class="empty">
        <h1>Ensimmäiset jutut tulossa pian</h1>
        <p>Kohta täällä on luettavaa julkkiksista, juoruista, urheilusta ja kaikesta mistä puhutaan. Käy pian uudestaan!</p>
      </div>
    {% endif %}
    {# Feed repeats: two stories side by side, then one full-width story. #}
    <div class="feed">
      {% set cardClass = "" %}
      {% for item in all | ohita(1) | alku(30) %}{% include "partials/card.njk" %}{% endfor %}
    </div>
  </div>

  <aside class="sidebar">
    {% if all.length %}
    <div class="tabs" role="tablist">
      <button class="tabs__btn" role="tab" aria-selected="true" aria-controls="tab-suosittua" id="t-suosittua">Suositut jutut <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg></button>
      <button class="tabs__btn" role="tab" aria-selected="false" aria-controls="tab-tuoreimmat" id="t-tuoreimmat">Tuoreimmat jutut <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M12 7v5.5l3.5 2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></button>
    </div>
    <ol class="side-list" role="tabpanel" id="tab-suosittua" aria-labelledby="t-suosittua">
      {% for item in all | nostot | alku(8) %}{% include "partials/side-item.njk" %}{% endfor %}
    </ol>
    <ol class="side-list" role="tabpanel" id="tab-tuoreimmat" aria-labelledby="t-tuoreimmat" hidden>
      {% for item in all | alku(8) %}{% include "partials/side-item.njk" %}{% endfor %}
    </ol>
    {% endif %}

    <section class="box ad-slot" aria-label="Mainos">Mainospaikka 300×250</section>
  </aside>
</div>
