---
layout: layouts/base.njk
---
{% set all = collections.artikkelit %}
{% set trending = collections.aiheet | nytPuhutaan %}
{% if trending.length %}
<nav class="trending" aria-label="Nyt puhutaan">
  <span class="trending__label">Nyt puhutaan</span>
  {% for a in trending %}<a class="topic" href="/aihe/{{ a.slug }}/">{{ a.name }}</a>{% endfor %}
</nav>
{% endif %}
{% if all.length %}
<div class="front">
  <div class="front__main">
    {% set item = all[0] %}{% include "partials/hero.njk" %}
    {% set top = all | ohita(1) | alku(6) %}
    {% if top.length %}
    <div class="top-grid">
      {% set cardClass = "" %}{% set showExcerpt = false %}
      {% for item in top %}{% include "partials/card.njk" %}{% endfor %}
    </div>
    {% endif %}
  </div>
  <aside class="sidebar" aria-label="Luetuimmat">
    <h2 class="block-title">Luetuimmat</h2>
    {% set picks = all | nostot | alku(6) %}
    <ol class="side-list side-list--num">
      {% for item in picks %}{% include "partials/side-item.njk" %}{% endfor %}
    </ol>
    <section class="side-box side-box--tip">
      <h2>Tiedätkö jotain, mitä me emme?</h2>
      <p>Lähetä juttuvinkki toimitukselle. Kaikki vinkit luetaan, ja voit vinkata myös nimettömänä.</p>
      <a class="side-box__btn" href="/vinkkaa/">Vinkkaa juttuaihe</a>
    </section>
    {% if site.social.length %}
    <section class="side-box">
      <h2>Seuraa Hulinaa</h2>
      <p>Uusimmat kohut ja puheenaiheet myös somessa.</p>
      <ul class="side-box__social">{% for s in site.social %}<li><a href="{{ s.url }}" target="_blank" rel="noopener me">{{ s.name }} <span>@hulinanet</span></a></li>{% endfor %}</ul>
    </section>
    {% endif %}
  </aside>
</div>

{% set rest = all | ohita(7) %}
{% for c in site.categories %}
  {% set inCat = rest | kategoriassa(c.slug) | alku(4) %}
  {% if inCat.length %}
  <section class="section">
    <h2 class="block-title"><a href="/kategoria/{{ c.slug }}/">{{ c.name }}</a> <a class="block-title__more" href="/kategoria/{{ c.slug }}/">Kaikki</a></h2>
    <div class="grid grid--4">
      {% set cardClass = "" %}{% set showExcerpt = false %}
      {% for item in inCat %}{% include "partials/card.njk" %}{% endfor %}
    </div>
  </section>
  {% endif %}
{% endfor %}
{% else %}
<div class="empty">
  <h1>Jutut julkaistaan pian</h1>
  <p>Hulina kirjoittaa julkkiksista, tv-ohjelmista, kohuista ja urheilusta.</p>
</div>
{% endif %}
