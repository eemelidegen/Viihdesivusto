---
layout: layouts/base.njk
---
{% set all = collections.artikkelit %}
{% if all.length %}
<div class="front">
  <div class="front__main">
    {% set item = all[0] %}{% include "partials/hero.njk" %}
    {% set top = all | ohita(1) | alku(6) %}
    {% if top.length %}
    <div class="top-grid">
      {% set cardClass = "" %}{% set showExcerpt = false %}
      {% for item in top %}{% include "partials/card.njk" %}{% endfor %}
    </div>
    {% endif %}
  </div>
  <aside class="sidebar" aria-label="Luetuimmat">
    <h2 class="block-title">Luetuimmat</h2>
    {% set picks = all | nostot | alku(6) %}
    <ol class="side-list side-list--num">
      {% for item in picks %}{% include "partials/side-item.njk" %}{% endfor %}
    </ol>
    {% if build.now < 1794175199000 %}
    <a class="side-promo" href="/arvonta/"><img src="/assets/img/arvonta-airpods-5.jpg" alt="" width="74" height="74" loading="lazy"><div><b>Voita Apple AirPods 5</b><span>Osallistu arvontaan →</span></div></a>
    {% endif %}
  </aside>
</div>

{% set rest = all | ohita(7) %}
{% for c in site.categories %}
  {% set inCat = rest | kategoriassa(c.slug) | alku(4) %}
  {% if inCat.length %}
  <section class="section">
    <h2 class="block-title"><a href="/kategoria/{{ c.slug }}/">{{ c.name }}</a> <a class="block-title__more" href="/kategoria/{{ c.slug }}/">Kaikki</a></h2>
    <div class="grid grid--4">
      {% set cardClass = "" %}{% set showExcerpt = false %}
      {% for item in inCat %}{% include "partials/card.njk" %}{% endfor %}
    </div>
  </section>
  {% endif %}
{% endfor %}
{% else %}
<div class="empty">
  <h1>Jutut julkaistaan pian</h1>
  <p>Hulina kirjoittaa julkkiksista, tv-ohjelmista, kohuista ja urheilusta.</p>
</div>
{% endif %}
