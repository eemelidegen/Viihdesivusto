---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in collections.all %}{% if p.url and not p.url.endsWith(".html") %}
  <url><loc>{{ p.url | absUrl(site.url) }}</loc><lastmod>{{ p.date | iso }}</lastmod></url>
{% endif %}{% endfor %}
</urlset>
