---
permalink: /news-sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
{% for a in collections.artikkelit | tuoreet(2) %}
  <url>
    <loc>{{ a.url | absUrl(site.url) }}</loc>
    <news:news>
      <news:publication><news:name>{{ site.name }}</news:name><news:language>{{ site.lang }}</news:language></news:publication>
      <news:publication_date>{{ a.date | iso }}</news:publication_date>
      <news:title>{{ a.data.title | escape }}</news:title>
    </news:news>
  </url>
{% endfor %}
</urlset>
