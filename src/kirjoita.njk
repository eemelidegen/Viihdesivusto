$("aiheet").addEventListener("input", topicChips);
$("category").addEventListener("click", (e) => { const b = e.target.closest("button"); if (!b) return; doc.fields.category = b.dataset.value; fill(); changed(); });
function grow(t) { if (t.id === "body" || t.id === "title" || t.id === "excerpt") { t.style.height = "auto"; t.style.height = Math.max(t.id === "body" ? 320 : 0, t.scrollHeight + 2) + "px"; } }
document.querySelectorAll("textarea").forEach((t) => t.addEventListener("input", () => grow(t)));
$("title").addEventListener("keydown", (e) => { if (e.key === "Enter") e.preventDefault(); });

// ---------- Images: resized in the browser to a light JPG ----------
function showImage() {
  const src = doc.newImage ? doc.newImage.dataUrl : doc.image;
  $("imgbox").hidden = !src; $("drop").hidden = !!src;
  if (src) $("imgPreview").src = src;
}
async function takeImage(file) {
  if (!file || !file.type.startsWith("image/")) return;
  $("status").textContent = "Käsitellään kuvaa…";
  try {
    const url = URL.createObjectURL(file);
    const img = await new Promise((ok, fail) => { const i = new Image(); i.onload = () => ok(i); i.onerror = fail; i.src = url; });
    const scale = Math.min(1, 1600 / Math.max(img.width, img.height));
    const c = document.createElement("canvas");
    c.width = Math.round(img.width * scale); c.height = Math.round(img.height * scale);
    c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
    URL.revokeObjectURL(url);
    const dataUrl = c.toDataURL("image/jpeg", 0.85);
    doc.newImage = { dataUrl, base64: dataUrl.split(",")[1] };
    showImage(); changed();
    $("status").textContent = `Kuva valmis (${Math.round(doc.newImage.base64.length * 0.75 / 1024)} kt).`;
  } catch {
    $("status").textContent = "Kuvaa ei voitu avata. Kokeile JPG- tai PNG-kuvaa.";
  }
}
// Photos inside the text: resized like the main photo, uploaded when the story is saved.
async function resized(file, max) {
  const url = URL.createObjectURL(file);
  try {
    const img = await new Promise((ok, fail) => { const i = new Image(); i.onload = () => ok(i); i.onerror = fail; i.src = url; });
    const scale = Math.min(1, max / Math.max(img.width, img.height));
    const c = document.createElement("canvas");
    c.width = Math.round(img.width * scale); c.height = Math.round(img.height * scale);
    c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
    return c.toDataURL("image/jpeg", 0.85);
  } finally { URL.revokeObjectURL(url); }
}
$("bodyFiles").addEventListener("change", async () => {
  const files = [...$("bodyFiles").files].filter((f) => f.type.startsWith("image/")); $("bodyFiles").value = "";
  if (!files.length) return;
  $("status").textContent = "Käsitellään kuvia…";
  const lines = [];
  for (const f of files) {
    try {
      const dataUrl = await resized(f, 1600);
      const name = `kuva-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}.jpg`;
      doc.images.push({ name, dataUrl, base64: dataUrl.split(",")[1] });
      lines.push(`![](/assets/img/uploads/${name} "")`);
    } catch { $("status").textContent = "Jotain kuvaa ei voitu avata."; }
  }
  if (!lines.length) return;
  const t = $("body"), at = t.selectionEnd ?? t.value.length, v = t.value;
  const before = v.slice(0, at).replace(/\s*$/, ""), after = v.slice(at).replace(/^\s*/, "");
  t.value = (before ? before + "\n\n" : "") + lines.join("\n\n") + (after ? "\n\n" + after : "");
  doc.body = t.value; grow(t); changed();
  $("status").textContent = lines.length > 1 ? `${lines.length} kuvaa lisätty – ne näkyvät jutussa kuvagalleriana. Kuvatekstin voit kirjoittaa lainausmerkkien väliin.` : "Kuva lisätty. Kuvatekstin voit kirjoittaa lainausmerkkien väliin.";
});
$("drop").addEventListener("click", () => $("file").click());
$("drop").addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); $("file").click(); } });
$("imgChange").addEventListener("click", () => $("file").click());
$("imgRemove").addEventListener("click", () => { doc.newImage = null; doc.image = ""; showImage(); changed(); });
$("file").addEventListener("change", () => { takeImage($("file").files[0]); $("file").value = ""; });
["dragover", "dragenter"].forEach((t) => $("drop").addEventListener(t, (e) => { e.preventDefault(); $("drop").classList.add("over"); }));
["dragleave", "drop"].forEach((t) => $("drop").addEventListener(t, () => $("drop").classList.remove("over")));
$("drop").addEventListener("drop", (e) => { e.preventDefault(); takeImage(e.dataTransfer.files[0]); });
document.addEventListener("paste", (e) => { const f = [...(e.clipboardData?.files || [])].find((x) => x.type.startsWith("image/")); if (f) { e.preventDefault(); takeImage(f); } });

// ---------- Text toolbar (writes Markdown) ----------
$("toolbar").addEventListener("click", (e) => {
  const b = e.target.closest("button"); if (!b) return;
  const t = $("body"), s = t.selectionStart, end = t.selectionEnd, v = t.value, sel = v.slice(s, end);
  const lineStart = v.lastIndexOf("\n", s - 1) + 1;
  let out, cs, ce;
  const wrapSel = (mark, ph) => { const text = sel || ph; out = v.slice(0, s) + mark + text + mark + v.slice(end); cs = s + mark.length; ce = cs + text.length; };
  const prefixLines = (pre) => {
    const block = v.slice(lineStart, end) || "";
    const text = (block || "teksti").split("\n").map((l) => (l.startsWith(pre) ? l : pre + l)).join("\n");
    out = v.slice(0, lineStart) + text + v.slice(end); cs = lineStart; ce = lineStart + text.length;
  };
  switch (b.dataset.cmd) {
    case "bold": wrapSel("**", "lihavoitu"); break;
    case "italic": wrapSel("*", "kursivoitu"); break;
    case "h2": prefixLines("## "); break;
    case "h3": prefixLines("### "); break;
    case "olist": { const block = v.slice(lineStart, end) || "teksti"; const text = block.split("\n").map((l, i) => (/^\d+\. /.test(l) ? l : `${i + 1}. ${l}`)).join("\n"); out = v.slice(0, lineStart) + text + v.slice(end); cs = lineStart; ce = lineStart + text.length; break; }
    case "fact": { const box = "> **Fakta**\n> " + (sel || "Kirjoita tähän tärkeimmät taustatiedot.\n> Yksi asia per rivi."); const before = v.slice(0, s).replace(/\s*$/, ""), after = v.slice(end).replace(/^\s*/, ""); out = (before ? before + "\n\n" : "") + box + (after ? "\n\n" + after : ""); cs = (before ? before.length + 2 : 0) + 12; ce = cs + box.length - 12; break; }
    case "readalso": { pickReadAlso(); return; }
    case "tidy": {
      const n = tidy(v), nt = tidy(doc.fields.title), ne = tidy(doc.fields.excerpt);
      if (n === v && nt === doc.fields.title && ne === doc.fields.excerpt) { $("status").textContent = "Tekstissä ei ollut korjattavaa."; return; }
      doc.fields.title = nt; doc.fields.excerpt = ne; $("title").value = nt; $("excerpt").value = ne;
      out = n; cs = ce = Math.min(s, n.length); break;
    }
    case "quote": prefixLines("> "); break;
    case "list": prefixLines("- "); break;
    case "image": $("bodyFiles").click(); return;
    case "embed": {
      const url = (prompt("Liitä videon tai somepostauksen osoite (YouTube, TikTok, Instagram tai X)", "https://") || "").trim();
      if (!/^https?:\/\/\S+$/.test(url) || url === "https://") return;
      const before = v.slice(0, end).replace(/\s*$/, ""), after = v.slice(end).replace(/^\s*/, "");
      out = (before ? before + "\n\n" : "") + url + (after ? "\n\n" + after : ""); cs = ce = (before ? before.length + 2 : 0) + url.length; break;
    }
    case "link": {
      const url = prompt("Linkin osoite (alkaa https://)", "https://");
      if (!url || url === "https://") return;
      const text = sel || "linkki";
      out = v.slice(0, s) + `[${text}](${url})` + v.slice(end); cs = s + 1; ce = cs + text.length; break;
    }
  }
  t.value = out; t.focus(); t.setSelectionRange(cs, ce);
  doc.body = t.value; grow(t); changed();
  if (b.dataset.cmd === "tidy") $("status").textContent = "Lainausmerkit, viivat ja välilyönnit korjattu.";
});

// ---------- Preview (small Markdown subset, same look as the site) ----------
const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const inline = (s) => esc(s)
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/\[([^\]]+)\]\(((?:https?:\/\/|\/)[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
function markdown(md) {
  return md.replace(/\r\n/g, "\n").split(/\n{2,}/).map((block) => {
    const b = block.trim(); if (!b) return "";
    const lines = b.split("\n");
    const imgs = lines.map((l) => l.match(/^!\[([^\]]*)\]\((\S+)(?:\s+"([^"]*)")?\)$/));
    if (imgs.every(Boolean)) return imgs.map((m) => { const own = doc.images.find((i) => m[2].endsWith("/" + i.name)); return `<figure class="inline-img"><img src="${esc(own ? own.dataUrl : m[2])}" alt="${esc(m[1])}">${m[3] ? `<figcaption>${esc(m[3])}</figcaption>` : ""}</figure>`; }).join("");
    if (/^https?:\/\/\S+$/.test(b) && /youtu|tiktok|instagram|twitter\.com|x\.com/.test(b)) return `<div class="embed"><span class="embed__btn">▶ Upotettu sisältö</span><p class="embed__note">${esc(b)}</p></div>`;
    if (b.startsWith("### ")) return `<h3>${inline(b.slice(4))}</h3>`;
    if (b.startsWith("## ")) return `<h2>${inline(b.slice(3))}</h2>`;
    if (lines.every((l) => l.startsWith(">"))) return `<blockquote><p>${lines.map((l) => inline(l.replace(/^>\s?/, ""))).join("<br>")}</p></blockquote>`;
    if (lines.every((l) => /^[-*] /.test(l))) return `<ul>${lines.map((l) => `<li>${inline(l.slice(2))}</li>`).join("")}</ul>`;
    if (lines.every((l) => /^\d+\. /.test(l))) return `<ol>${lines.map((l) => `<li>${inline(l.replace(/^\d+\. /, ""))}</li>`).join("")}</ol>`;
    return `<p>${lines.map(inline).join("<br>")}</p>`;
  }).join("");
}
const fiDateTime = new Intl.DateTimeFormat("fi-FI", { day: "numeric", month: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit" });
function preview() {
  const cat = CATEGORIES.find((c) => c.slug === doc.fields.category) || CATEGORIES[0];
  $("pvCat").textContent = cat.name;
  $("pvTitle").textContent = doc.fields.title || "Otsikko";
  $("pvLead").textContent = doc.fields.excerpt;
  const words = (doc.body.match(/\S+/g) || []).length;
  $("pvMeta").textContent = `${doc.fields.author || "Toimitus"} · ${fiDateTime.format(doc.date ? new Date(doc.date) : new Date())} · ${Math.max(1, Math.round(words / 200))} min lukuaika`;
  const src = doc.newImage ? doc.newImage.dataUrl : doc.image;
  $("pvFig").innerHTML = src ? `<img src="${esc(src)}" alt="">${doc.fields.imageCredit ? `<figcaption>Kuva: ${esc(doc.fields.imageCredit)}</figcaption>` : ""}` : '<span class="placeholder"></span>';
  $("pvBody").innerHTML = markdown(doc.body) || '<p style="color:#999">Teksti näkyy tässä…</p>';
  const srcs = sourceList().filter((x) => x.n || x.u);
  if (srcs.length) $("pvBody").insertAdjacentHTML("beforeend", `<aside class="sources"><p class="sources__title">Lähteet</p><ul>${srcs.map((x) => `<li>${x.u ? `<a href="${esc(x.u)}" target="_blank" rel="noopener">${esc(x.n || x.u)}</a>` : esc(x.n)}</li>`).join("")}</ul></aside>`);
  counter("titleCount", doc.fields.title.length, 30, 100);
  counter("excerptCount", doc.fields.excerpt.length, 60, 180);
  const slugTxt = (doc.fields.title || "otsikko").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60);
  $("serpSlug").textContent = slugTxt;
  $("serpTitle").textContent = (doc.fields.title || "Otsikko").slice(0, 62) + ((doc.fields.title || "").length > 62 ? " …" : "") + " | Hulina";
  $("serpDesc").textContent = (doc.fields.excerpt || "Ingressi näkyy tässä hakutuloksessa.").slice(0, 158) + ((doc.fields.excerpt || "").length > 158 ? " …" : "");
  $("fbTitle").textContent = doc.fields.title || "Otsikko";
  $("fbImg").style.backgroundImage = src ? `url("${src}")` : "";
  $("fbImg").style.backgroundPosition = doc.fields.imageFocus || "50% 30%";
  checklist();
  $("status").dataset.words = words;
}
$("togglePreview").addEventListener("click", () => { const p = $("preview"); p.classList.toggle("show"); $("togglePreview").textContent = p.classList.contains("show") ? "Piilota esikatselu" : "Näytä esikatselu"; if (p.classList.contains("show")) p.scrollIntoView({ behavior: "smooth" }); });

// ---------- Server calls ----------
async function api(path, body) {
  const res = await fetch(`/api/toimitus/${path}`, body ? { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) } : {});
  const data = await res.json().catch(() => ({}));
  if (res.status === 401 && data.kirjaudu) {
    persist();
    location.href = "/api/kirjaudu?next=" + encodeURIComponent("/admin/kirjoita/");
    throw new Error("login");
  }
  if (!res.ok) throw new Error(data.virhe || "Jokin meni pieleen. Yritä uudelleen.");
  return data;
}

async function save(asDraft) {
  if (!doc.fields.title.trim()) { $("status").textContent = "Lisää jutulle otsikko."; $("title").focus(); return; }
  if (!asDraft && !doc.body.trim() && !confirm("Jutussa ei ole tekstiä. Julkaistaanko silti?")) return;
  snapshot();
  ["publish", "saveDraft"].forEach((id) => ($(id).disabled = true));
  $("status").textContent = asDraft ? "Tallennetaan luonnosta…" : "Julkaistaan…";
  // A story gets its publication time when it is first published.
  const date = !doc.date || (doc.wasDraft && !asDraft) ? new Date().toISOString() : doc.date;
  try {
    const res = await api("julkaise", {
      file: doc.file,
      fields: { ...doc.fields, date, draft: asDraft, image: doc.newImage ? "" : doc.image,
        paivitetty: !asDraft && doc.file && !doc.wasDraft && $("markUpdated").checked ? new Date().toISOString() : (doc.fields.paivitetty || "") },
      body: doc.body,
      image: doc.newImage ? { base64: doc.newImage.base64 } : null,
      images: doc.images.filter((i) => doc.body.includes(i.name)).map(({ name, base64 }) => ({ name, base64 })),
    });
    Object.assign(doc, { file: res.file, date, wasDraft: asDraft, image: res.image || "", newImage: null, images: [] });
    dirty = false; persist(); showImage();
    showDone(asDraft, res.url);
    $("status").textContent = asDraft ? "Luonnos tallennettu." : "Julkaistu!";
  } catch (e) {
    if (e.message !== "login") { $("status").textContent = e.message; showError(e.message); }
  } finally {
    ["publish", "saveDraft"].forEach((id) => ($(id).disabled = false));
  }
}
async function pickReadAlso() {
  try {
    const { jutut } = await api("jutut");
    const pub = jutut.filter((j) => !j.draft && j.file !== doc.file).slice(0, 15);
    if (!pub.length) { alert("Julkaistuja juttuja ei vielä ole."); return; }
    const n = prompt("Mihin juttuun linkitetään? Kirjoita numero:\n\n" + pub.map((j, i) => `${i + 1}. ${j.title}`).join("\n"));
    const j = pub[Number(n) - 1]; if (!j) return;
    const slug = j.file.replace(/\.md$/, "").replace(/^\d{4}-\d{2}-\d{2}-/, "");
    const t = $("body"), at = t.selectionEnd, v = t.value, line = `**Lue myös:** [${j.title}](/${slug}/)`;
    const before = v.slice(0, at).replace(/\s*$/, ""), after = v.slice(at).replace(/^\s*/, "");
    t.value = (before ? before + "\n\n" : "") + line + (after ? "\n\n" + after : ""); doc.body = t.value; grow(t); changed();
  } catch (e) { if (e.message !== "login") alert(e.message); }
}
$("publish").addEventListener("click", () => { const miss = checklist(); if (miss.length && !confirm("Jutusta puuttuu vielä:\n\n• " + miss.join("\n• ") + "\n\nJulkaistaanko silti?")) return; save(false); });
$("saveDraft").addEventListener("click", () => save(true));

function showError(msg) { const d = $("done"); d.hidden = false; d.className = "error"; d.textContent = msg; }
function showDone(draft, url) {
  const d = $("done"); d.hidden = false; d.className = "done";
  d.innerHTML = draft
    ? `<h2>Luonnos tallennettu</h2><p>Luonnos ei näy lukijoille. Löydät sen Jutut-välilehdeltä.</p><div class="row2"><button type="button" data-act="new" class="alt">Uusi juttu</button></div>`
    : `<h2>Juttu julkaistu! 🎉</h2><p>Se näkyy sivulla noin minuutin kuluttua.</p><div class="row2"><a href="${url}" target="_blank" rel="noopener">Avaa juttu</a><button type="button" data-act="some">Tee somekuva</button><button type="button" data-act="new" class="alt">Uusi juttu</button></div>`;
  d.scrollIntoView({ behavior: "smooth" });
}
$("done").addEventListener("click", (e) => {
  const act = e.target.closest("[data-act]")?.dataset.act;
  if (act === "new") newDoc();
  if (act === "some") toSomekuva();
});
function toSomekuva() {
  // Hand the story's title, photo and credit over to the social image tool.
  const image = doc.newImage ? doc.newImage.dataUrl : doc.image;
  const handoff = { title: doc.fields.title, credit: doc.fields.imageCredit || "", image: image || "", t: Date.now() };
  try { localStorage.setItem("hulina-somekuva-juttu", JSON.stringify(handoff)); }
  catch { try { localStorage.setItem("hulina-somekuva-juttu", JSON.stringify({ ...handoff, image: "" })); } catch {} }
  location.href = "/admin/somekuva/";
}
function newDoc() {
  if (dirty && !confirm("Tallentamattomat muutokset katoavat. Aloitetaanko uusi juttu?")) return;
  doc = blank(); dirty = false; persist(); $("done").hidden = true; fill(); switchView("editor"); $("title").focus();
}

// ---------- Article list ----------
async function loadList() {
  const box = $("list");
  box.innerHTML = '<div class="empty2">Ladataan juttuja…</div>';
  try {
    allJutut = (await api("jutut")).jutut;
    drawList();
  } catch (e) {
    if (e.message !== "login") box.innerHTML = `<div class="error">${esc(e.message)}</div>`;
  }
}
let allJutut = [], listFilter = "all";
function drawList() {
  const box = $("list"), q = $("q").value.trim().toLowerCase();
  const jutut = allJutut.filter((j) => (!q || j.title.toLowerCase().includes(q))
    && (listFilter === "all" || (listFilter === "pub" && !j.draft) || (listFilter === "draft" && j.draft) || listFilter === "c:" + j.category));
  const pubN = allJutut.filter((j) => !j.draft).length;
  $("stats").textContent = `${allJutut.length} juttua · ${pubN} julkaistu · ${allJutut.length - pubN} luonnosta` + (jutut.length !== allJutut.length ? ` · näytetään ${jutut.length}` : "");
  if (!jutut.length) { box.innerHTML = `<div class="empty2">${allJutut.length ? "Ei hakua vastaavia juttuja." : "Ei vielä juttuja. Kirjoita ensimmäinen!"}</div>`; return; }
  {
    box.innerHTML = jutut.map((j) => {
      const cat = CATEGORIES.find((c) => c.slug === j.category);
      const slug = j.file.replace(/\.md$/, "").replace(/^\d{4}-\d{2}-\d{2}-/, "");
      return `<div class="item">
        <div class="item__thumb">${j.image ? `<img src="${esc(j.image)}" alt="" loading="lazy" onerror="this.remove()">` : ""}</div>
        <div><p class="item__title">${esc(j.title)}</p>
          <div class="item__meta">${j.draft ? '<span class="tag2">Luonnos</span>' : ""}<span>${cat ? esc(cat.name) : ""}</span><span>${j.date ? fiDateTime.format(new Date(j.date)) : ""}</span></div></div>
        <div class="item__actions">
          <button type="button" class="primary" data-edit="${esc(j.file)}">Muokkaa</button>
          ${j.draft ? "" : `<a href="/${slug}/" target="_blank" rel="noopener">Avaa</a><button type="button" data-copy="https://hulina.net/${slug}/">Kopioi linkki</button>`}
          <button type="button" data-dup="${esc(j.file)}">Kopioi pohjaksi</button>
          <button type="button" class="danger" data-del="${esc(j.file)}" data-title="${esc(j.title)}">Poista</button>
        </div></div>`;
    }).join("");
  }
}
$("q").addEventListener("input", drawList);
$("filt").addEventListener("click", (e) => { const b = e.target.closest("button"); if (!b) return; listFilter = b.dataset.f; $("filt").querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b))); drawList(); });
$("list").addEventListener("click", async (e) => {
  const edit = e.target.closest("[data-edit]"), del = e.target.closest("[data-del]"), cp = e.target.closest("[data-copy]"), dup = e.target.closest("[data-dup]");
  if (cp) { try { await navigator.clipboard.writeText(cp.dataset.copy); cp.textContent = "Kopioitu ✓"; } catch { prompt("Kopioi linkki:", cp.dataset.copy); } return; }
  if (dup) {
    if (dirty && !confirm("Tallentamattomat muutokset katoavat. Jatketaanko?")) return;
    try {
      const j = await api(`juttu?tiedosto=${encodeURIComponent(dup.dataset.dup)}`);
      doc = { ...blank(), image: j.fields.image || "", body: j.body,
        fields: { ...blank().fields, ...Object.fromEntries(Object.entries(j.fields).filter(([k]) => k in blank().fields)), title: "Kopio: " + (j.fields.title || ""), paivitetty: "", nosto: false } };
      dirty = true; persist(); $("done").hidden = true; fill(); switchView("editor"); $("title").focus();
    } catch (err) { if (err.message !== "login") alert(err.message); }
    return;
  }
  if (edit) {
    if (dirty && !confirm("Tallentamattomat muutokset katoavat. Avataanko toinen juttu?")) return;
    edit.textContent = "Avataan…";
    try {
      const j = await api(`juttu?tiedosto=${encodeURIComponent(edit.dataset.edit)}`);
      doc = { ...blank(), file: j.file, wasDraft: !!j.fields.draft, date: j.fields.date || null, image: j.fields.image || "", body: j.body,
        fields: { ...blank().fields, ...Object.fromEntries(Object.entries(j.fields).filter(([k]) => k in blank().fields)) } };
      dirty = false; persist(); $("done").hidden = true; fill(); switchView("editor");
    } catch (err) { if (err.message !== "login") alert(err.message); edit.textContent = "Muokkaa"; }
  }
  if (del) {
    if (!confirm(`Poistetaanko juttu "${del.dataset.title}" pysyvästi?`)) return;
    del.textContent = "Poistetaan…";
    try {
      await api("poista", { file: del.dataset.del });
      if (doc.file === del.dataset.del) { doc = blank(); persist(); fill(); }
      loadList();
    } catch (err) { if (err.message !== "login") alert(err.message); del.textContent = "Poista"; }
  }
});

// ---------- Comment moderation ----------
const STATUS = { ok: "Näkyvissä", review: "Odottaa tarkistusta", hidden: "Piilotettu" };
async function loadMod() {
  const box = $("modList"); box.innerHTML = '<div class="empty2">Ladataan kommentteja…</div>';
  try {
    const r = await api("kommentit");
    if (!r.kaytossa) { $("modStats").textContent = ""; box.innerHTML = '<div class="empty2">Kommentointi ei ole vielä käytössä. Liitä Cloudflaressa D1-tietokanta nimellä DB (ohjeet saat Claudelta).</div>'; return; }
    $("modStats").textContent = `${r.kayttajat} käyttäjää · ${r.kommentit} kommenttia · ${r.jonossa} odottaa tarkistusta tai piilotettu`;
    if (!r.kommentit.length) { box.innerHTML = '<div class="empty2">Ei vielä kommentteja.</div>'; return; }
    box.innerHTML = r.kommentit.map((c) => `<div class="mod mod--${esc(c.status)}">
      <div class="mod__head"><b>${esc(c.name)}</b>${c.banned ? '<span class="tag2">Estetty</span>' : ""}<span>${fiDateTime.format(new Date(c.created))}</span><a href="/${esc(c.story)}/#kommentit" target="_blank" rel="noopener">${esc(c.story)}</a><span>${STATUS[c.status] || esc(c.status)}</span>${c.reports ? `<span>⚑ ${c.reports} ilmoitusta</span>` : ""}</div>
      <p class="mod__body">${esc(c.body)}</p>
      <div class="item__actions">
        ${c.status !== "ok" ? `<button type="button" class="primary" data-mod="hyvaksy" data-id="${c.id}">Hyväksy</button>` : `<button type="button" data-mod="piilota" data-id="${c.id}">Piilota</button>`}
        <button type="button" class="danger" data-mod="poista" data-id="${c.id}">Poista</button>
        ${c.banned ? "" : `<button type="button" class="danger" data-mod="esta" data-id="${c.id}">Estä käyttäjä</button>`}
      </div></div>`).join("");
  } catch (e) { if (e.message !== "login") box.innerHTML = `<div class="error">${esc(e.message)}</div>`; }
}
$("modList").addEventListener("click", async (e) => {
  const b = e.target.closest("[data-mod]"); if (!b) return;
  const act = b.dataset.mod;
  if (act === "poista" && !confirm("Poistetaanko kommentti pysyvästi?")) return;
  if (act === "esta" && !confirm("Estetäänkö käyttäjä? Kaikki hänen kommenttinsa piilotetaan, eikä hän voi enää kommentoida.")) return;
  b.disabled = true;
  try { await api("kommentit", { id: Number(b.dataset.id), toiminto: act }); loadMod(); } catch (err) { if (err.message !== "login") alert(err.message); b.disabled = false; }
});

// ---------- Views ----------
function switchView(v) {
  document.querySelectorAll(".tabs2 button").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.view === v)));
  $("view-editor").hidden = v !== "editor"; $("view-list").hidden = v !== "list"; $("view-mod").hidden = v !== "mod"; $("bar").hidden = v !== "editor";
  if (v === "list") loadList();
  if (v === "mod") loadMod();
}
document.querySelector(".tabs2").addEventListener("click", (e) => { const b = e.target.closest("button"); if (b) switchView(b.dataset.view); });
addEventListener("beforeunload", (e) => { if (dirty) { persist(); } });

restore(); fill();
if (doc.file || doc.fields.title || doc.body) $("status").textContent = "Jatka siitä, mihin jäit.";
</script>
</body>
</html>
