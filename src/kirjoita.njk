// ---------- Finnish typography cleanup ----------
function tidy(text) {
  return text
    .replace(/[ \t]+$/gm, "").replace(/ {2,}/g, " ")
    .replace(/^(\s*)(-|--) (?=\S)/gm, "$1– ")          // dialogue dash
    .replace(/ -- | - /g, " – ")                         // dash between words
    .replace(/(\d) ?- ?(\d)/g, "$1–$2")                  // number ranges
    .replace(/"([^"\n]*)"/g, "”$1”").replace(/[“„]/g, "”") // Finnish quotes
    .replace(/'([^'\n]*)'/g, "’$1’")
    .replace(/\.\.\./g, "…")
    .replace(/\n{3,}/g, "\n\n");
}

// ---------- Keyboard shortcuts ----------
document.addEventListener("keydown", (e) => {
  if (!(e.ctrlKey || e.metaKey)) return;
  const k = e.key.toLowerCase();
  if (k === "s") { e.preventDefault(); save(true); return; }
  if (document.activeElement !== $("body")) return;
  const cmd = { b: "bold", i: "italic", k: "link" }[k];
  if (cmd) { e.preventDefault(); document.querySelector(`#toolbar [data-cmd="${cmd}"]`).click(); }
});

// ---------- Checklist ----------
function checklist() {
  const f = doc.fields, words = (doc.body.match(/\S+/g) || []).length, hasImg = !!(doc.newImage || doc.image);
  const items = [
    [f.title.length >= 30 && f.title.length <= 100, `Otsikon pituus ${f.title.length} merkkiä (hyvä 30–100)`, !f.title],
    [f.excerpt.length >= 60, f.excerpt ? `Ingressi ${f.excerpt.length} merkkiä` : "Ingressi puuttuu", !f.excerpt],
    [hasImg, hasImg ? "Pääkuva lisätty" : "Pääkuva puuttuu"],
    [!hasImg || !!f.imageCredit.trim(), "Kuvaaja tai kuvan lähde merkitty", hasImg && !f.imageCredit.trim()],
    [!hasImg || !!f.imageAlt.trim(), "Kuvan kuvaus (näkövammaisille ja Googlelle)"],
    [!!f.aiheet.trim(), "Vähintään yksi aihe"],
    [words >= 120, `Tekstiä ${words} sanaa (suositus vähintään 120)`],
    [!!f.lahteet.trim() || /lähde|mukaan/i.test(doc.body), "Lähde mainittu", !f.lahteet.trim() && !/lähde|mukaan/i.test(doc.body)],
    [words < 300 || /^##\s/m.test(doc.body), "Väliotsikko pidemmässä jutussa"],
    [!/[“"]/.test(doc.body + f.title), "Lainausmerkit suomalaisittain ” ” (✨ Siisti teksti korjaa)"],
  ];
  const ok = items.filter((x) => x[0]).length;
  $("checks").innerHTML = items.map(([good, text, bad]) => `<li class="${good ? "" : bad ? "bad" : "no"}">${esc(text)}</li>`).join("");
  $("score").textContent = `${ok}/${items.length}`;
  return items.filter((x) => !x[0] && x[2]).map((x) => x[1]);
}


// Topic suggestions from the published stories
