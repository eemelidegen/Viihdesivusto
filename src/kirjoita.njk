---
permalink: /admin/kirjoita/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="fi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Kirjoita – {{ site.name }}</title>
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <style>
    [hidden] { display: none !important; }
    body { background: var(--soft); }
    .top { background: var(--plum); color: #fff; position: sticky; top: 0; z-index: 10; }
    .top__bar { max-width: 1240px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
    .top .logo { margin-right: 0; color: #fff; }
    .top .logo svg { height: 40px; }
    .tabs2 { display: flex; gap: 4px; }
    .tabs2 button, .top a.link { background: none; border: 0; color: #cfcdd4; font: 700 20px/1 var(--display); text-transform: uppercase; letter-spacing: .03em; padding: 8px 10px; cursor: pointer; text-decoration: none; border-bottom: 3px solid transparent; }
    .tabs2 button[aria-selected="true"] { color: var(--pink); border-bottom-color: var(--pink); }
    .top .right { margin-left: auto; display: flex; gap: 6px; align-items: center; }
    .top a.link:hover, .tabs2 button:hover { color: #fff; }

    .wrap2 { max-width: 1240px; margin: 0 auto; padding: 20px 16px 120px; }
    .editor { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: start; }
    .card2 { background: #fff; border-radius: 10px; padding: 20px; display: grid; gap: 18px; margin-bottom: 14px; }
    .card2 h2 { margin: 0; font: 800 20px/1 var(--display); text-transform: uppercase; letter-spacing: .03em; }
    .f { display: grid; gap: 6px; font: 600 14px/1.3 var(--font); }
    .f small { font-weight: 400; color: var(--muted); }
    .f input[type=text], .f textarea { font: 16px/1.5 var(--font); padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; width: 100%; resize: vertical; background: #fff; color: var(--text); }
    .f textarea { overflow: hidden; }
    #title { font: 800 28px/1.15 var(--headline); padding: 12px 14px; resize: none; }
    #body { min-height: 320px; font: 18px/1.65 var(--serif); }
    .seg2 { display: flex; gap: 8px; flex-wrap: wrap; }
    .seg2 button { flex: 1 1 0; min-width: 120px; padding: 12px; border: 2px solid var(--line); border-radius: 8px; background: #fff; cursor: pointer; font: 800 20px/1 var(--display); text-transform: uppercase; letter-spacing: .03em; color: var(--text); }
    .seg2 button[aria-pressed="true"] { border-color: var(--accent); background: var(--accent); color: var(--plum); }
    .drop { border: 2px dashed var(--line); border-radius: 10px; padding: 22px; text-align: center; color: var(--muted); cursor: pointer; display: grid; gap: 8px; place-items: center; }
    .drop.over { border-color: var(--accent); background: var(--soft); }
    .drop b { color: var(--text); font: 800 20px/1 var(--display); text-transform: uppercase; }
    .imgbox { position: relative; border-radius: 10px; overflow: hidden; background: #111; }
    .imgbox img { display: block; width: 100%; max-height: 360px; object-fit: contain; }
    .imgbox .imgbtns { position: absolute; right: 10px; bottom: 10px; display: flex; gap: 8px; }
    .mini { padding: 8px 12px; border: 0; border-radius: 6px; background: rgba(0,0,0,.75); color: #fff; font: 700 15px/1 var(--display); text-transform: uppercase; cursor: pointer; }
    .toolbar { display: flex; gap: 6px; flex-wrap: wrap; }
    .toolbar button { min-width: 42px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: #fff; cursor: pointer; font: 700 15px/1 var(--font); color: var(--text); }
    .toolbar button:hover { border-color: var(--plum); }
    .switch2 { display: flex; align-items: center; justify-content: space-between; gap: 12px; font: 600 15px/1.3 var(--font); cursor: pointer; }
    .switch2 small { display: block; font-weight: 400; color: var(--muted); }
    .switch2 input { appearance: none; width: 52px; height: 30px; border-radius: 999px; background: #ccc; position: relative; cursor: pointer; flex-shrink: 0; margin: 0; transition: background .2s; }
    .switch2 input::after { content: ""; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.3); transition: transform .2s; }
    .switch2 input:checked { background: var(--accent); }
    .switch2 input:checked::after { transform: translateX(22px); }
    details.more summary { cursor: pointer; font: 700 15px/1 var(--font); color: var(--muted); }

    .preview2 { position: sticky; top: 80px; background: #fff; border-radius: 10px; padding: 24px; max-height: calc(100vh - 100px); overflow: auto; }
    .preview2__label { font: 800 14px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 12px; }
    .preview2 .article { max-width: none; }
    .preview2 .article__head h1 { font-size: 40px; }
    .preview2 .prose { font-size: 18px; }

    .bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1px solid var(--line); z-index: 9; }
    .bar__in { max-width: 1240px; margin: 0 auto; padding: 12px 16px; display: flex; gap: 10px; align-items: center; }
    .bar__status { flex: 1; color: var(--muted); font-size: 14px; }
    .btn2 { padding: 14px 22px; border: 0; border-radius: 8px; cursor: pointer; font: 800 20px/1 var(--display); text-transform: uppercase; letter-spacing: .03em; background: var(--accent); color: var(--plum); }
    .btn2--ghost { background: #fff; color: var(--text); border: 2px solid var(--text); }
    .btn2:disabled { opacity: .5; cursor: wait; }

    .done { background: var(--plum); color: #fff; border-radius: 10px; padding: 22px; display: grid; gap: 12px; margin-bottom: 14px; }
    .done h2 { margin: 0; font: 400 32px/1.1 var(--headline); }
    .done p { margin: 0; color: #cfcdd4; }
    .done .row2 { display: flex; gap: 10px; flex-wrap: wrap; }
    .done a, .done button { padding: 10px 16px; border-radius: 6px; border: 0; background: var(--accent); color: var(--plum); text-decoration: none; font: 800 17px/1 var(--display); text-transform: uppercase; cursor: pointer; }
    .done .alt { background: #fff; color: var(--plum); }
    .error { background: #fff0f2; color: #a3112a; border-radius: 8px; padding: 12px 14px; font-weight: 600; }

    .list { display: grid; gap: 10px; }
    .item { background: #fff; border-radius: 10px; padding: 12px; display: grid; grid-template-columns: 120px minmax(0, 1fr) auto; gap: 16px; align-items: center; }
    .item__thumb { aspect-ratio: 16 / 10; border-radius: 6px; overflow: hidden; background: linear-gradient(135deg, #3b3943, #15141a); }
    .item__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .item__title { font: 400 22px/1.15 var(--headline); margin: 0 0 6px; }
    .item__meta { font-size: 13px; color: var(--muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .tag2 { background: #ffc94d; color: var(--plum); font: 800 13px/1 var(--display); text-transform: uppercase; padding: 4px 8px; border-radius: 4px; }
    .item__actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .item__actions a, .item__actions button { padding: 8px 12px; border-radius: 6px; border: 1px solid var(--line); background: #fff; color: var(--text); font: 700 15px/1 var(--display); text-transform: uppercase; cursor: pointer; text-decoration: none; }
    .item__actions .primary { background: var(--plum); color: #fff; border-color: var(--plum); }
    .item__actions .danger { color: #a3112a; }
    .chips2 { display: flex; flex-wrap: wrap; gap: 6px; }
    .chips2 button { padding: 6px 11px 5px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font: 700 13px/1 var(--display); cursor: pointer; }
    .chips2 button:hover { border-color: #111; }
    .hint2 { margin: -8px 0 0; color: var(--muted); font: 12.5px/1.4 var(--font); }
    .empty2 { background: #fff; border-radius: 10px; padding: 32px; text-align: center; color: var(--muted); }

    .count { font-weight: 400; font-size: 12px; color: var(--muted); margin-left: 6px; }
    .count.ok { color: #1f8a4c; } .count.warn { color: #b25e00; }
    .row3 { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .sel2 { padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: #fff; font: 600 14px/1 var(--font); color: var(--text); }
    .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; font: 14px/1.35 var(--font); }
    .checks li { display: flex; gap: 9px; align-items: flex-start; }
    .checks li::before { content: "✓"; flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font: 800 12px/1 var(--font); background: #dff3e6; color: #1f8a4c; }
    .checks li.no::before { content: "!"; background: #fff1d6; color: #b25e00; }
    .checks li.bad::before { content: "!"; background: #ffe1e5; color: #a3112a; }
    .score { font: 800 15px/1 var(--display); text-transform: uppercase; letter-spacing: .04em; }
    .serp { border: 1px solid var(--line); border-radius: 10px; padding: 14px; font-family: Arial, sans-serif; display: grid; gap: 4px; }
    .serp__url { font-size: 12px; color: #4d5156; }
    .serp__title { font-size: 19px; color: #1a0dab; line-height: 1.25; }
    .serp__desc { font-size: 13.5px; color: #4d5156; line-height: 1.45; }
    .fbcard { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; font-family: Helvetica, Arial, sans-serif; }
    .fbcard__img { aspect-ratio: 1.91 / 1; background: #ddd center / cover; }
    .fbcard__txt { padding: 10px 12px; background: #f0f2f5; display: grid; gap: 3px; }
    .fbcard__site { font-size: 12px; color: #65676b; text-transform: uppercase; }
    .fbcard__title { font-size: 16px; font-weight: 700; color: #050505; line-height: 1.25; }
    .src-row { display: grid; grid-template-columns: 1fr 1.3fr auto; gap: 6px; }
    .src-row input { font: 15px/1.4 var(--font); padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; min-width: 0; }
    .src-row button { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 0 10px; cursor: pointer; }
    .focus-wrap { position: relative; cursor: crosshair; }
    .focus-dot { position: absolute; width: 26px; height: 26px; margin: -13px 0 0 -13px; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 2px rgba(0,0,0,.5), inset 0 0 0 2px rgba(0,0,0,.3); pointer-events: none; }
    .versions { display: grid; gap: 6px; }
    .versions button { text-align: left; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: #fff; cursor: pointer; font: 14px/1.3 var(--font); }
    .listbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
    .listbar input { flex: 1 1 220px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: 15px/1.3 var(--font); }
    .listbar .chips2 button[aria-pressed="true"] { background: var(--plum); color: #fff; border-color: var(--plum); }
    .stats { color: var(--muted); font-size: 13px; margin: 0 0 10px; }
    .mod { background: #fff; border-radius: 10px; padding: 14px 16px; display: grid; gap: 8px; }
    .mod--review { box-shadow: inset 4px 0 0 #e8a100; }
    .mod--hidden { opacity: .6; }
    .mod__head { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 13px; color: var(--muted); align-items: center; }
    .mod__head b { color: var(--text); font: 800 15px/1 var(--display); }
    .mod__body { margin: 0; white-space: pre-line; overflow-wrap: anywhere; font: 15px/1.5 var(--font); }
    .mod .item__actions { justify-content: flex-start; }
    .mobile-preview { display: none; }
    @media (max-width: 600px) {
      .top__bar { gap: 6px; padding: 8px 10px; flex-wrap: nowrap; }
      .top .logo svg { height: 26px; }
      .tabs2 { gap: 0; }
      .tabs2 button, .top a.link { font-size: 13px; letter-spacing: 0; padding: 8px 5px; }
      .top .right { gap: 0; }
    }
    @media (max-width: 340px) { .top .logo { display: none; } }
    @media (max-width: 900px) {
      .editor { grid-template-columns: 1fr; }
      .preview2 { position: static; max-height: none; display: none; }
      .preview2.show { display: block; }
      .mobile-preview { display: block; }
      .item { grid-template-columns: 84px minmax(0, 1fr); }
      .item__actions { grid-column: 1 / -1; justify-content: flex-start; }
      .bar__status { display: none; }
      .bar__in .btn2 { flex: 1; padding: 14px 10px; }
    }
  </style>
</head>
<body>
  <header class="top">
    <div class="top__bar">
      {% set logoClass = "" %}{% include "partials/logo.njk" %}
      <div class="tabs2" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-view="editor">Kirjoita</button>
        <button type="button" role="tab" aria-selected="false" data-view="list">Jutut</button>
        <button type="button" role="tab" aria-selected="false" data-view="mod">Kommentit</button>
      </div>
      <div class="right">
        <a class="link" href="/admin/somekuva/">Somekuva</a>
        <a class="link" href="/api/ulos">Ulos</a>
      </div>
    </div>
  </header>

  <main class="wrap2">
    <section id="view-editor">
      <div id="done" class="done" hidden></div>
      <div class="editor">
        <div>
          <div class="card2">
            <label class="f"><span>Otsikko <span class="count" id="titleCount"></span></span>
              <textarea id="title" rows="2" placeholder="Kirjoita iskevä otsikko" spellcheck="true" lang="fi"></textarea>
            </label>
            <label class="f"><span>Ingressi <span class="count" id="excerptCount"></span></span><small>1–2 lausetta, joilla lukija koukutetaan. Näkyy myös Googlessa ja Facebookissa.</small>
              <textarea id="excerpt" rows="2" spellcheck="true" lang="fi"></textarea>
            </label>
            <div class="f">Kategoria
              <div class="seg2" id="category">
                {% for c in site.categories %}<button type="button" data-value="{{ c.slug }}">{{ c.name }}</button>{% endfor %}
              </div>
            </div>
            <label class="f">Aiheet <small>Pilkulla erotettuna, esim. Big Brother, Tosi-tv. Saman aiheen jutut kootaan omalle sivulleen, ja suosituimmat näkyvät etusivun Nyt puhutaan -palkissa.</small>
              <input id="aiheet" type="text" maxlength="200" list="aiheLista" autocomplete="off">
            </label>
            <datalist id="aiheLista"></datalist>
            <div class="chips2" id="aiheChips"></div>
          </div>

          <div class="card2">
            <h2>Pääkuva</h2>
            <div id="drop" class="drop" tabindex="0" role="button">
              <b>Lisää kuva</b>
              <span>Napauta, vedä kuva tähän tai liitä (Ctrl+V)</span>
            </div>
            <div id="imgbox" class="imgbox focus-wrap" hidden title="Napauta kohtaa, joka ei saa rajautua pois (esim. kasvot)">
              <img id="imgPreview" alt="">
              <span class="focus-dot" id="focusDot"></span>
              <div class="imgbtns"><button type="button" class="mini" id="imgChange">Vaihda</button><button type="button" class="mini" id="imgRemove">Poista</button></div>
            </div>
            <input id="file" type="file" accept="image/*" hidden>
            <p class="hint2" id="focusHint" hidden>Napauta kuvasta kohtaa, joka on tärkein (esim. kasvot). Etusivun rajaukset keskittyvät siihen.</p>
            <label class="f">Kuvaaja / lähde <small>Esim. MTV / Tiedotekuva tai oma nimesi</small>
              <input id="imageCredit" type="text" maxlength="120">
            </label>
            <label class="f">Mitä kuvassa on? <small>Lyhyt kuvaus näkövammaisille ja Googlelle</small>
              <input id="imageAlt" type="text" maxlength="300">
            </label>
          </div>

          <div class="card2">
            <h2>Teksti</h2>
            <div class="toolbar" id="toolbar">
              <button type="button" data-cmd="bold" title="Lihavoi"><b>B</b></button>
              <button type="button" data-cmd="italic" title="Kursivoi"><i>K</i></button>
              <button type="button" data-cmd="h2" title="Väliotsikko">Väliotsikko</button>
              <button type="button" data-cmd="h3" title="Pieni väliotsikko">Pieni otsikko</button>
              <button type="button" data-cmd="quote" title="Lainaus">“ Lainaus</button>
              <button type="button" data-cmd="list" title="Lista">• Lista</button>
              <button type="button" data-cmd="olist" title="Numeroitu lista">1. Lista</button>
              <button type="button" data-cmd="fact" title="Faktalaatikko">ⓘ Faktalaatikko</button>
              <button type="button" data-cmd="readalso" title="Lue myös -linkki toiseen juttuun">↗ Lue myös</button>
              <button type="button" data-cmd="link" title="Linkki">Linkki</button>
              <button type="button" data-cmd="image" title="Lisää kuvia tekstiin">📷 Kuvia</button>
              <button type="button" data-cmd="embed" title="Upota video tai somepostaus">▶ Video / some</button>
              <button type="button" data-cmd="tidy" title="Korjaa lainausmerkit, viivat ja ylimääräiset välilyönnit">✨ Siisti teksti</button>
            </div>
            <div class="row3">
              <select class="sel2" id="tpl" aria-label="Juttupohja">
                <option value="">Juttupohja…</option>
                <option value="uutinen">Uutinen</option>
                <option value="lista">Lista (esim. 7 asiaa…)</option>
                <option value="some">Somekohu</option>
                <option value="tv">Tv-ohjelma / jakso</option>
                <option value="haastattelu">Haastattelu</option>
              </select>
              <span class="hint2" style="margin:0">Pikanäppäimet: Ctrl+B lihavoi, Ctrl+I kursivoi, Ctrl+K linkki, Ctrl+S tallentaa luonnoksen</span>
            </div>
            <input id="bodyFiles" type="file" accept="image/*" multiple hidden>
            <p class="hint2">Useampi kuva peräkkäin muuttuu pyyhkäistäväksi kuvagalleriaksi. Video: liitä YouTube-, TikTok-, Instagram- tai X-linkki omalle rivilleen.</p>
            <label class="f"><span class="sr-only">Teksti</span>
              <textarea id="body" placeholder="Kirjoita juttu tähän. Tyhjä rivi aloittaa uuden kappaleen." spellcheck="true" lang="fi"></textarea>
            </label>
          </div>

          <div class="card2">
            <h2>Lähteet</h2>
            <p class="hint2" style="margin:0">Näkyvät jutun lopussa omana laatikkonaan. Lähteiden merkitseminen tekee jutusta uskottavan.</p>
            <div id="sources" style="display:grid;gap:6px"></div>
            <div class="row3"><button type="button" class="mini" style="background:var(--plum)" id="addSource">+ Lisää lähde</button></div>
          </div>

          <div class="card2">
            <label class="switch2"><span>Nosta "Suositut jutut" -listaan<small>Näkyy etusivun sivupalkissa ja Luetuimmat-sivulla</small></span><input id="nosto" type="checkbox"></label>
            <label class="switch2" id="updRow" hidden><span>Merkitse päivitetyksi<small>Jutun yläosaan tulee "Päivitetty"-aika, kun tallennat muutokset</small></span><input id="markUpdated" type="checkbox" checked></label>
            <details class="more">
              <summary>Lisäasetukset</summary>
              <div style="display:grid;gap:14px;margin-top:14px">
                <label class="f">Toimittaja <small>Näkyy jutun alussa</small><input id="author" type="text" maxlength="80" placeholder="Toimitus"></label>
                <div class="f">Aiemmat versiot <small>Työkalu tallentaa tekstistä version muutaman minuutin välein tähän selaimeen.</small><div class="versions" id="versions"></div></div>
              </div>
            </details>
          </div>

          <button type="button" class="btn2 btn2--ghost mobile-preview" id="togglePreview" style="width:100%">Näytä esikatselu</button>
        </div>

        <aside class="preview2" id="preview">
          <p class="preview2__label">Tarkistuslista <span class="score" id="score"></span></p>
          <ul class="checks" id="checks"></ul>
          <p class="preview2__label" style="margin-top:22px">Näin juttu näkyy Googlessa</p>
          <div class="serp"><span class="serp__url">hulina.net › <span id="serpSlug"></span></span><span class="serp__title" id="serpTitle"></span><span class="serp__desc" id="serpDesc"></span></div>
          <p class="preview2__label" style="margin-top:22px">…ja Facebookissa</p>
          <div class="fbcard"><div class="fbcard__img" id="fbImg"></div><div class="fbcard__txt"><span class="fbcard__site">hulina.net</span><span class="fbcard__title" id="fbTitle"></span></div></div>
          <p class="preview2__label" style="margin-top:22px">Esikatselu</p>
          <article class="article">
            <header class="article__head">
              <span class="pill" id="pvCat"></span>
              <h1 id="pvTitle"></h1>
              <p class="article__lead" id="pvLead"></p>
              <p class="meta" id="pvMeta"></p>
            </header>
            <figure class="article__media" id="pvFig"></figure>
            <div class="prose" id="pvBody"></div>
          </article>
        </aside>
      </div>
    </section>

    <section id="view-mod" hidden>
      <p class="stats" id="modStats"></p>
      <div class="list" id="modList"></div>
    </section>

    <section id="view-list" hidden>
      <div class="listbar">
        <input type="search" id="q" placeholder="Hae otsikosta…" aria-label="Hae juttuja">
        <div class="chips2" id="filt"><button type="button" data-f="all" aria-pressed="true">Kaikki</button><button type="button" data-f="pub">Julkaistut</button><button type="button" data-f="draft">Luonnokset</button>{% for c in site.categories %}<button type="button" data-f="c:{{ c.slug }}">{{ c.name }}</button>{% endfor %}</div>
      </div>
      <p class="stats" id="stats"></p>
      <div class="list" id="list"></div>
    </section>
  </main>

  <div class="bar" id="bar">
    <div class="bar__in">
      <span class="bar__status" id="status">Muutokset tallentuvat tähän selaimeen automaattisesti.</span>
      <button type="button" class="btn2 btn2--ghost" id="saveDraft">Tallenna luonnos</button>
      <button type="button" class="btn2" id="publish">Julkaise</button>
    </div>
  </div>

<script>
const CATEGORIES = {{ site.categories | dump | safe }};
const LOCAL = "valokeila-kirjoita";
const $ = (id) => document.getElementById(id);
const blank = () => ({ file: null, wasDraft: true, date: null, image: "", newImage: null, fields: { title: "", excerpt: "", category: CATEGORIES[0].slug, aiheet: "", imageCredit: "", imageAlt: "", imageFocus: "", lahteet: "", paivitetty: "", author: "", nosto: false }, body: "", images: [] });
let doc = blank();
let dirty = false;

// ---------- Local autosave ----------
function persist() { try { localStorage.setItem(LOCAL, JSON.stringify(doc)); } catch { try { localStorage.setItem(LOCAL, JSON.stringify({ ...doc, newImage: null, images: [] })); } catch {} } }
function restore() { try { const d = JSON.parse(localStorage.getItem(LOCAL) || "null"); if (d && d.fields) doc = { ...blank(), ...d, fields: { ...blank().fields, ...d.fields } }; } catch {} }

// ---------- Form <-> doc ----------
const TEXT = ["title", "excerpt", "aiheet", "imageCredit", "imageAlt", "author"];
function fill() {
  TEXT.forEach((k) => ($(k).value = doc.fields[k] || ""));
  $("body").value = doc.body || "";
  $("nosto").checked = !!doc.fields.nosto;
  $("updRow").hidden = !(doc.file && !doc.wasDraft);
  renderSources(); renderVersions();
  topicChips();
  document.querySelectorAll("#category button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === doc.fields.category)));
  showImage();
  document.querySelectorAll("textarea").forEach(grow);
  preview();
}
function changed() { dirty = true; persist(); preview(); const w = Number($("status").dataset.words || 0); $("status").textContent = `Tallennettu tähän selaimeen · ${w} sanaa · ${Math.max(1, Math.round(w / 200))} min lukuaika – muista julkaista.`; }
TEXT.forEach((k) => $(k).addEventListener("input", () => { doc.fields[k] = $(k).value; changed(); }));
$("body").addEventListener("input", () => { doc.body = $("body").value; changed(); });
$("nosto").addEventListener("change", () => { doc.fields.nosto = $("nosto").checked; changed(); });

// ---------- Counters ----------
function counter(id, len, lo, hi) {
  const el = $(id); el.textContent = len ? `${len} merkkiä` : "";
  el.className = "count" + (len ? (len >= lo && len <= hi ? " ok" : " warn") : "");
  el.title = `Hyvä pituus ${lo}–${hi} merkkiä`;
}

// ---------- Sources ----------
function sourceList() { return (doc.fields.lahteet || "").split(";").map((x) => x.trim()).filter(Boolean).map((x) => { const [n, u = ""] = x.split("|").map((y) => y.trim()); return { n, u }; }); }
function setSources(list) { doc.fields.lahteet = list.filter((x) => x.n || x.u).map((x) => `${x.n.replace(/[|;]/g, " ")} | ${x.u.replace(/[|;\s]/g, "")}`).join("; "); }
function renderSources() {
  const list = sourceList(); if (!list.length) list.push({ n: "", u: "" });
  $("sources").innerHTML = list.map((x, i) => `<div class="src-row" data-i="${i}"><input placeholder="Lähde, esim. Iltalehti" value="${esc(x.n)}" data-p="n"><input placeholder="https://…" value="${esc(x.u)}" data-p="u"><button type="button" aria-label="Poista lähde">✕</button></div>`).join("");
}
$("sources").addEventListener("input", () => { setSources([...$("sources").querySelectorAll(".src-row")].map((r) => ({ n: r.querySelector('[data-p="n"]').value, u: r.querySelector('[data-p="u"]').value }))); changed(); });
$("sources").addEventListener("click", (e) => { const b = e.target.closest("button"); if (!b) return; const list = sourceList(); list.splice(Number(b.parentElement.dataset.i), 1); setSources(list); renderSources(); changed(); });
$("addSource").addEventListener("click", () => { const rows = [...$("sources").querySelectorAll(".src-row")]; if (rows.length && !rows.at(-1).querySelector("input").value) { rows.at(-1).querySelector("input").focus(); return; } const list = sourceList(); list.push({ n: "", u: "" }); $("sources").insertAdjacentHTML("beforeend", `<div class="src-row" data-i="${list.length - 1}"><input placeholder="Lähde, esim. Iltalehti" data-p="n"><input placeholder="https://…" data-p="u"><button type="button" aria-label="Poista lähde">✕</button></div>`); $("sources").lastElementChild.querySelector("input").focus(); });

// ---------- Image focus point ----------
$("imgbox").addEventListener("click", (e) => {
  if (e.target.closest("button")) return;
  const img = $("imgPreview"), r = img.getBoundingClientRect();
  const x = Math.round(Math.min(100, Math.max(0, (e.clientX - r.left) / r.width * 100)));
  const y = Math.round(Math.min(100, Math.max(0, (e.clientY - r.top) / r.height * 100)));
  doc.fields.imageFocus = `${x}% ${y}%`; placeDot(); changed();
});
function placeDot() {
  const img = $("imgPreview"), dot = $("focusDot"), box = $("imgbox");
  const m = (doc.fields.imageFocus || "").match(/(\d+)% (\d+)%/);
  $("focusHint").hidden = box.hidden;
  if (!m || !img.naturalWidth) { dot.hidden = true; return; }
  const br = box.getBoundingClientRect(), r = img.getBoundingClientRect();
  dot.hidden = false; dot.style.left = (r.left - br.left + r.width * m[1] / 100) + "px"; dot.style.top = (r.top - br.top + r.height * m[2] / 100) + "px";
}
$("imgPreview").addEventListener("load", placeDot);
addEventListener("resize", placeDot);

// ---------- Version history (this browser) ----------
const VKEY = "hulina-kirjoita-versiot";
function versions() { try { return JSON.parse(localStorage.getItem(VKEY) || "[]"); } catch { return []; } }
function snapshot() {
  if (!doc.body.trim() && !doc.fields.title.trim()) return;
  const v = versions(), last = v[0];
  if (last && last.body === doc.body && last.title === doc.fields.title) return;
  v.unshift({ t: Date.now(), title: doc.fields.title, excerpt: doc.fields.excerpt, body: doc.body });
  try { localStorage.setItem(VKEY, JSON.stringify(v.slice(0, 15))); } catch {}
  renderVersions();
}
setInterval(() => { if (dirty) snapshot(); }, 180000);
function renderVersions() {
  const v = versions();
  $("versions").innerHTML = v.length ? v.map((x, i) => `<button type="button" data-v="${i}">${fiDateTime.format(new Date(x.t))} – ${esc((x.title || "nimetön").slice(0, 60))} (${(x.body.match(/\S+/g) || []).length} sanaa)</button>`).join("") : '<span class="hint2" style="margin:0">Ei vielä versioita.</span>';
}
$("versions").addEventListener("click", (e) => {
  const b = e.target.closest("button"); if (!b) return;
  const x = versions()[Number(b.dataset.v)]; if (!x || !confirm("Palautetaanko tämä versio? Nykyinen teksti tallennetaan ensin versioksi.")) return;
  snapshot(); doc.fields.title = x.title; doc.fields.excerpt = x.excerpt || doc.fields.excerpt; doc.body = x.body; fill(); changed();
});

