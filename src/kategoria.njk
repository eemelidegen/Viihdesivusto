---
layout: layouts/base.njk
pagination:
  data: site.categories
  size: 1
  alias: cat
permalink: "/kategoria/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.name }}"
---
<header class="page-head">
  <h1>{{ cat.name }}</h1>
</header>
{% set inCat = collections.artikkelit | kategoriassa(cat.slug) %}
{% if inCat.length %}
{% set item = inCat[0] %}{% include "partials/hero.njk" %}
<div class="grid grid--3 cat-grid">
  {% set cardClass = "" %}{% set showExcerpt = false %}
  {% for item in inCat | ohita(1) %}{% include "partials/card.njk" %}{% endfor %}
</div>
{% else %}
<p>Tässä kategoriassa ei ole vielä juttuja.</p>
{% endif %}
