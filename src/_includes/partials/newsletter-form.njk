<form class="newsletter" action="/api/uutiskirje" method="post" data-newsletter>
  <label class="sr-only" for="nl-email-{{ formId }}">Sähköposti</label>
  <input id="nl-email-{{ formId }}" type="email" name="email" placeholder="sinä@esimerkki.fi" autocomplete="email" required>
  <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
  <button type="submit">Tilaa</button>
  <p class="newsletter__status" role="status" aria-live="polite"></p>
  <p class="newsletter__fine">Tilaamalla hyväksyt, että käsittelemme osoitettasi <a href="/tietosuoja/">tietosuojaselosteen</a> mukaisesti. Voit perua tilauksen milloin tahansa jokaisen viestin lopussa olevasta linkistä.</p>
</form>
