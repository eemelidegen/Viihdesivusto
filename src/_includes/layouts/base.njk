<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " | " + site.name) if title else (site.name + " – " + site.tagline) %}
  {% set pageDesc = excerpt or description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{{ 'article' if category else 'website' }}">
  <meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
  {% set ogImage = ("/og/" + page.fileSlug + ".png") if category else "/og/default.png" %}
  <meta property="og:image" content="{{ ogImage | absUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title or site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ ogImage | absUrl(site.url) }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/league-spartan-800.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Siirry sisältöön</a>
  <header class="masthead">
    <div class="wrap masthead__bar">
      {% set logoClass = "" %}{% include "partials/logo.njk" %}
      <nav class="nav" aria-label="Päävalikko">
        <ul class="nav__list">
          <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Etusivu</a></li>
          <li><a href="/uusimmat/" {% if page.url == "/uusimmat/" %}aria-current="page"{% endif %}>Uusimmat</a></li>
          <li><a href="/luetuimmat/" {% if page.url == "/luetuimmat/" %}aria-current="page"{% endif %}>Luetuimmat</a></li>
          {% for c in site.categories %}<li><a href="/kategoria/{{ c.slug }}/" {% if page.url == "/kategoria/" + c.slug + "/" %}aria-current="page"{% endif %}>{{ c.name }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <a class="tip-btn" href="/vinkkaa/">Vinkkaa</a>
    </div>
    {% if category %}<div class="read-progress" aria-hidden="true"></div>{% endif %}
  </header>

  <main id="main" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        {% set logoClass = "logo--small" %}{% include "partials/logo.njk" %}
        <p>{{ site.description }}</p>
      </div>
      <div>
        <h2>Kategoriat</h2>
        <ul>{% for c in site.categories %}<li><a href="/kategoria/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}</ul>
      </div>
      <div>
        <h2>Toimitus</h2>
        <ul>
          <li><a href="/vinkkaa/">Vinkkaa juttuaihe</a></li>
          <li><a href="/tietoa/">Tietoa meistä &amp; julkaisutiedot</a></li>
          <li><a href="/tietosuoja/">Tietosuojaseloste</a></li>
          {% if site.email %}<li><a href="mailto:{{ site.email }}">Vinkki toimitukselle</a></li>{% endif %}
        </ul>
      </div>
    </div>
    <p class="wrap footer__legal">© {{ build.year }} {{ site.name }}</p>
  </footer>
  <button class="to-top" aria-label="Takaisin ylös"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <script src="/assets/js/main.js?v={{ build.version }}" defer></script>
</body>
</html>
