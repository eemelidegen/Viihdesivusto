<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " | " + site.name) if title else (site.name + " – " + site.tagline) %}
  {% set pageDesc = excerpt or description or (site.homeDescription if page.url == "/" else site.description) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{{ 'article' if category else 'website' }}">
  <meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
  {# Link previews show the story's own photo without text; the generated title card is only a fallback. #}
  {% set ogImage = (image if (category and image) else (("/og/" + page.fileSlug + ".png") if category else "/og/default.png")) %}
  <meta property="og:image" content="{{ ogImage | absUrl(site.url) }}">
  {% if not (category and image) %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta property="og:image:alt" content="{{ (imageAlt if (category and image and imageAlt) else (title or site.name)) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ ogImage | absUrl(site.url) }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/img/icon-180.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#ffffff">
  <meta name="robots" content="max-image-preview:large">
  <script>try { if (localStorage.getItem("hulina-teema") === "dark") document.documentElement.dataset.theme = "dark"; } catch {}</script>
  <link rel="preload" href="/assets/fonts/roboto-condensed-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  {% if site.adsense %}
  {# Google's consent message (Privacy & messaging in AdSense); loaded on its own so it shows even before ads are served #}
  <script async src="https://fundingchoicesmessages.google.com/i/{{ site.adsense | replace('ca-', '') }}?ers=1"></script>
  <script>(function(){function s(){if(!window.frames.googlefcPresent){if(document.body){var i=document.createElement("iframe");i.style.cssText="width:0;height:0;border:none;z-index:-1000;left:-1000px;top:-1000px;display:none";i.name="googlefcPresent";document.body.appendChild(i)}else{setTimeout(s,0)}}}s()})();</script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsense }}" crossorigin="anonymous"></script>
  {% endif %}
  {% block head %}{% endblock %}
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "NewsMediaOrganization", "@id": "{{ site.url }}/#org", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/",
        "logo": { "@type": "ImageObject", "url": "{{ '/assets/img/icon-512.png' | absUrl(site.url) }}" },
        "description": {{ site.description | dump | safe }},
        "publishingPrinciples": "{{ '/periaatteet/' | absUrl(site.url) }}",
        "correctionsPolicy": "{{ '/periaatteet/' | absUrl(site.url) }}",
        "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %}, {% endif %}{% endfor %}] },
      { "@type": "WebSite", "@id": "{{ site.url }}/#website", "name": {{ site.name | dump | safe }}, "alternateName": ["Hulina.net", "hulina.net"], "url": "{{ site.url }}/", "inLanguage": "fi", "publisher": { "@id": "{{ site.url }}/#org" },
        "potentialAction": { "@type": "SearchAction", "target": "{{ site.url }}/haku/?q={q}", "query-input": "required name=q" } }
    ]
  }
  </script>
  {% endif %}
</head>
<body>
  <a class="skip" href="#main">Siirry sisältöön</a>
  <header class="masthead">
    <div class="wrap masthead__bar">
      {% set logoClass = "" %}{% include "partials/logo.njk" %}
      <span class="masthead__date" data-today></span>
      <a class="search-btn acc-btn" href="/tili/" aria-label="Oma tili" data-acc><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="4" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M4.5 20.5c1.2-3.8 4.2-5.6 7.5-5.6s6.3 1.8 7.5 5.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="acc-btn__name" data-acc-name></span></a>
      <a class="search-btn search-btn--search" href="/haku/" aria-label="Haku"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></a>
      <button class="menu-btn" type="button" aria-label="Valikko" aria-expanded="false" aria-controls="menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></button>
      <div class="menu" id="menu" hidden>
        <button class="menu__theme" type="button" role="switch" aria-checked="false">Tumma teema <span class="switch" aria-hidden="true"></span></button>
        <ul class="menu__links">
          <li><a href="/tili/" data-acc-menu>Kirjaudu / luo tili</a></li>
          <li><a href="/haku/">Haku</a></li>
          <li><a href="/tietoa/">Tietoa meistä</a></li>
          <li><a href="/ota-yhteytta/">Ota yhteyttä</a></li>
          <li><a href="/tietosuoja/">Tietosuojaseloste</a></li>
        </ul>
      </div>
    </div>
    <nav class="nav" aria-label="Päävalikko">
      <ul class="wrap nav__list">
        <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Etusivu</a></li>
        <li><a href="/uusimmat/" {% if page.url == "/uusimmat/" %}aria-current="page"{% endif %}>Uusimmat</a></li>
        {% for c in site.categories %}<li><a href="/kategoria/{{ c.slug }}/" {% if page.url == "/kategoria/" + c.slug + "/" %}aria-current="page"{% endif %}>{{ c.name }}</a></li>
        {% endfor %}
        <li><a href="/luetuimmat/" {% if page.url == "/luetuimmat/" %}aria-current="page"{% endif %}>Luetuimmat</a></li>
      </ul>
    </nav>
    {% if category %}<div class="read-progress" aria-hidden="true"></div>{% endif %}
  </header>

  <main id="main" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        {% set logoClass = "logo--small" %}{% include "partials/logo.njk" %}
        <p>Kohut, julkkikset ja tosi-tv. Täältä luet, mistä Suomi puhuu tänään.</p>
        {% if site.social.length %}<p class="footer__social">{% for s in site.social %}<a href="{{ s.url }}" target="_blank" rel="noopener me">{{ s.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %} @hulinanet</p>{% endif %}
        <p class="footer__principles">Löysitkö virheen? <a href="/ota-yhteytta/">Kerro meille</a>, niin korjaamme sen.</p>
      </div>
      <div>
        <h2>Kategoriat</h2>
        <ul>{% for c in site.categories %}<li><a href="/kategoria/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}</ul>
      </div>
      <div>
        <h2>Toimitus</h2>
        <ul>
          <li><a href="/periaatteet/">Toimituksen periaatteet</a></li>
          <li><a href="/kommentointi/">Kommentointisäännöt</a></li>
          <li><a href="/tietoa/">Tietoa meistä &amp; julkaisutiedot</a></li>
          <li><a href="/ota-yhteytta/">Ota yhteyttä</a></li>
          <li><a href="/tietosuoja/">Tietosuojaseloste</a></li>
          {% if site.adsense %}<li><button type="button" class="linkbtn" data-consent>Evästeasetukset</button></li>{% endif %}
        </ul>
      </div>
    </div>
    <div class="wrap footer__legal">
      <span>© {{ build.year }} {{ site.name }}</span>
      <span>Julkaisija: {{ site.publisher }}</span>
      <span>Toimitus: <a href="/ota-yhteytta/">ota yhteyttä</a></span>
      <span><a href="/tietosuoja/">Tietosuoja</a></span>
    </div>
  </footer>
  <button class="to-top" aria-label="Takaisin ylös"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <script src="/assets/js/main.js?v={{ build.version }}" defer></script>
</body>
</html>
