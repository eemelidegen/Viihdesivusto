<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " | " + site.name) if title else (site.name + " – " + site.tagline) %}
  {% set pageDesc = excerpt or description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{{ 'article' if category else 'website' }}">
  <meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
  {% if image %}<meta property="og:image" content="{{ image | absUrl(site.url) }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700;800&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Siirry sisältöön</a>
  <header class="masthead">
    <div class="wrap masthead__bar">
      {% set logoClass = "" %}{% include "partials/logo.njk" %}
      <nav class="nav" aria-label="Päävalikko">
        <ul class="nav__list">
          <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Etusivu</a></li>
          <li><a href="/uusimmat/" {% if page.url == "/uusimmat/" %}aria-current="page"{% endif %}>Uusimmat</a></li>
          <li><a href="/luetuimmat/" {% if page.url == "/luetuimmat/" %}aria-current="page"{% endif %}>Luetuimmat</a></li>
          <li><a href="/kategoria/julkkikset/" {% if page.url == "/kategoria/julkkikset/" %}aria-current="page"{% endif %}>Julkkikset</a></li>
        </ul>
      </nav>
      <a class="tip-btn" href="/vinkkaa/">Vinkkaa</a>
    </div>
  </header>

  <main id="main" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        {% set logoClass = "logo--small" %}{% include "partials/logo.njk" %}
        <p>{{ site.description }}</p>
      </div>
      <div>
        <h2>Kategoriat</h2>
        <ul>{% for c in site.categories %}<li><a href="/kategoria/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}</ul>
      </div>
      <div>
        <h2>Toimitus</h2>
        <ul>
          <li><a href="/vinkkaa/">Vinkkaa juttuaihe</a></li>
          <li><a href="/tietoa/">Tietoa meistä &amp; julkaisutiedot</a></li>
          <li><a href="/tietosuoja/">Tietosuojaseloste</a></li>
          {% if site.email %}<li><a href="mailto:{{ site.email }}">Vinkki toimitukselle</a></li>{% endif %}
          <li><a href="/uutiskirje/">Tilaa uutiskirje</a></li>
          <li><a href="/feed.xml">RSS-syöte</a></li>
        </ul>
      </div>
    </div>
    <p class="wrap footer__legal">© {{ build.year }} {{ site.name }}. Noudatamme Journalistin ohjeita.</p>
  </footer>
  <button class="to-top" aria-label="Takaisin ylös"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
