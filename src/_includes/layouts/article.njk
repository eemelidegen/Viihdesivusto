---
layout: layouts/base.njk
---
{% set cat = category | kategoria(site.categories) %}
<article class="article">
  <header class="article__head">
    <a class="pill" href="/kategoria/{{ cat.slug }}/">{{ cat.name }}</a>
    <h1>{{ title }}</h1>
    <p class="article__lead">{{ excerpt }}</p>
    <div class="byline">
      <img class="byline__avatar" src="/assets/img/icon-192.png" alt="" width="40" height="40">
      <div class="byline__text">
        <span class="byline__name">{{ (author if author and author != "Toimitus" else "Hulinan toimitus") }}</span>
        <span class="byline__meta">
          Julkaistu <time datetime="{{ page.date | iso }}">{{ page.date | pvmAika }}</time>
          {% if paivitetty %}<span class="byline__upd">· Päivitetty <time datetime="{{ paivitetty | iso }}">{{ paivitetty | pvmAika }}</time></span>{% endif %}
          · {{ content | lukuaika }} min lukuaika
        </span>
      </div>
    </div>
  </header>
  <figure class="article__media">
    {% if image %}
      <span class="article__img" data-fit><img src="{{ image }}" alt="{{ imageAlt }}"{% if imageFocus %} style="object-position: {{ imageFocus }}"{% endif %}></span>
      {% if imageCredit %}<figcaption>Kuva: {% if imageLink %}<a href="{{ imageLink }}" target="_blank" rel="noopener">{{ imageCredit }}</a>{% else %}{{ imageCredit }}{% endif %}</figcaption>{% endif %}
    {% else %}
      <span class="placeholder"></span>
    {% endif %}
  </figure>
  {% set picks = collections.artikkelit | lueMyos(page.url, category) %}
  {% set lueMyosBox = "" %}
  {% if picks.length %}{% set lueMyosBox %}
    <aside class="read-also" aria-label="Lue myös">
      <span class="read-also__label">Lue myös</span>
      {% for item in picks %}
      <a class="read-also__item" href="{{ item.url }}">
        <span class="read-also__thumb">{% if item.data.image %}<img src="{{ item.data.image }}" alt="" loading="lazy">{% else %}<span class="placeholder"></span>{% endif %}</span>
        <span class="read-also__title">{{ item.data.title }}</span>
      </a>
      {% endfor %}
    </aside>
  {% endset %}{% endif %}
  <div class="prose">
    {{ content | rikasta | keskelle(lueMyosBox) | safe }}
  </div>
  {% set sources = lahteet | lahteet %}
  {% if sources.length %}
  <aside class="sources" aria-label="Lähteet">
    <p class="sources__title">Lähteet</p>
    <ul>{% for l in sources %}<li>{% if l.url %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.name }}</a>{% else %}{{ l.name }}{% endif %}</li>{% endfor %}</ul>
  </aside>
  {% endif %}
  <section class="comments" id="kommentit" data-story="{{ page.fileSlug }}" hidden>
    <h2 class="comments__title">Kommentit <span class="comments__count"></span></h2>
    <div class="comments__form"></div>
    <ol class="comments__list"></ol>
  </section>
  <p class="article__foot">Huomasitko virheen? <a href="/vinkkaa/?juttu={{ title | urlencode }}">Ilmoita siitä toimitukselle</a> · <a href="/periaatteet/">Toimituksen periaatteet</a></p>
  {% set topics = aiheet | aiheLista %}
  {% if topics.length %}
  <p class="topics" aria-label="Aiheet">{% for a in topics %}<a class="topic" href="/aihe/{{ a.slug }}/">#{{ a.name }}</a>{% endfor %}</p>
  {% endif %}
  <aside class="newsroom" aria-label="Tietoa toimituksesta">
    <img src="/assets/img/icon-192.png" alt="" width="48" height="48" loading="lazy">
    <div>
      <p class="newsroom__name">Hulinan toimitus</p>
      <p>Hulina on suomalainen viihdemedia. Juttumme perustuvat lähteisiin, ja virheet korjataan avoimesti. <a href="/periaatteet/">Näin työskentelemme</a> · <a href="/vinkkaa/">Lähetä juttuvinkki</a></p>
    </div>
  </aside>
  {% set shareUrl = page.url | absUrl(site.url) %}
  <footer class="share" aria-label="Jaa juttu">
    <span class="share__label">Jaa juttu</span>
    <button class="share__btn share__btn--native" type="button" data-share data-url="{{ shareUrl }}" data-title="{{ title }}" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Jaa</button>
    <a class="share__btn" href="https://wa.me/?text={{ (title + ' ' + shareUrl) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
    <a class="share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" target="_blank" rel="noopener">Facebook</a>
    <a class="share__btn" href="https://x.com/intent/post?url={{ shareUrl | urlencode }}&text={{ title | urlencode }}" target="_blank" rel="noopener">X</a>
    <button class="share__btn copy-link" type="button" data-url="{{ shareUrl }}">Kopioi linkki</button>
  </footer>
</article>

{% set next = collections.artikkelit | seuraava(page.url) %}
{% if next %}
<a class="next-story" href="{{ next.url }}">
  <span class="next-story__thumb">{% if next.data.image %}<img src="{{ next.data.image }}" alt="" loading="lazy">{% else %}<span class="placeholder"></span>{% endif %}</span>
  <span class="next-story__text"><span class="next-story__label">Seuraava juttu →</span><span class="next-story__title">{{ next.data.title }}</span></span>
</a>
{% endif %}

{% set related = collections.artikkelit | kategoriassa(category) | ilman(page.url) | alku(3) %}
{% if related.length %}
<section class="section">
  <h2 class="section__title">Lisää aiheesta: {{ cat.name }}</h2>
  <div class="grid grid--3">
    {% for item in related %}{% include "partials/card.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": {{ title | dump | safe }},
  "description": {{ excerpt | dump | safe }},
  "datePublished": "{{ page.date | iso }}",
  "dateModified": "{{ (paivitetty or page.date) | iso }}",
  "mainEntityOfPage": "{{ page.url | absUrl(site.url) }}",
  "articleSection": {{ cat.name | dump | safe }},
  "keywords": {{ (aiheet or "") | dump | safe }},
  {% if author and author != "Toimitus" %}"author": { "@type": "Person", "name": {{ author | dump | safe }} },{% else %}"author": { "@type": "Organization", "name": "Hulinan toimitus", "url": "{{ '/tietoa/' | absUrl(site.url) }}" },{% endif %}
  "publisher": { "@type": "NewsMediaOrganization", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}", "logo": { "@type": "ImageObject", "url": "{{ '/assets/img/icon-512.png' | absUrl(site.url) }}" } },
  "image": [{% if image %}"{{ image | absUrl(site.url) }}", {% endif %}"{{ ('/og/' + page.fileSlug + '.png') | absUrl(site.url) }}"]
}
</script>
