---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.name }}</title>
  <link>{{ site.url }}/</link>
  <description>{{ site.description }}</description>
  <language>fi</language>
  <atom:link href="{{ '/feed.xml' | absUrl(site.url) }}" rel="self" type="application/rss+xml"/>
  {% for item in collections.artikkelit | alku(30) %}
  <item>
    <title>{{ item.data.title }}</title>
    <link>{{ item.url | absUrl(site.url) }}</link>
    <guid>{{ item.url | absUrl(site.url) }}</guid>
    <pubDate>{{ item.date | rfc822 }}</pubDate>
    <description>{{ item.data.excerpt }}</description>
  </item>
  {% endfor %}
</channel>
</rss>
